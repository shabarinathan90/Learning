#!/bin/bash

# === Configurable Inputs
FEED_NAME="$1"
TRADE_DATE=$(date '+%d-%b-%Y')   # like 25-Jun-2025
HTML_FILE="/tmp/${FEED_NAME}_sanity_${TRADE_DATE}.html"
VERTICA_DB="vdb"
VERTICA_USER="your_user"
VERTICA_PASS="your_password"
EMAIL_FROM="noreply@yourdomain.com"

# === Get recipient emails
EMAIL_TO=$(vsql -U "$VERTICA_USER" -w "$VERTICA_PASS" -d "$VERTICA_DB" -tAc \
"SELECT recipient_emails FROM sanity_check_config WHERE feed_name = '$FEED_NAME' LIMIT 1;")

# === HTML header
cat > "$HTML_FILE" <<EOF
<html>
<head>
  <style>
    body { font-family: Calibri, sans-serif; }
    table { border-collapse: collapse; }
    th, td { border: 1px solid #999; padding: 8px; text-align: left; }
    th { background-color: #f0f0f0; }
  </style>
</head>
<body>
<p>Hi,</p>
<h3>Sanity Check Report - ${FEED_NAME}</h3>
<p><b>Trade Date:</b> ${TRADE_DATE}</p>
EOF

# === Get list of queries for the feed
vsql -U "$VERTICA_USER" -w "$VERTICA_PASS" -d "$VERTICA_DB" -F '|' -At -c \
"SELECT query_seq, description, sanity_query FROM sanity_check_config WHERE feed_name = '$FEED_NAME' ORDER BY query_seq;" |
while IFS='|' read -r seq desc raw_query; do
  # Replace placeholders
  final_query=$(echo "$raw_query" | sed "s/:TRADE_DATE/'$TRADE_DATE'/g" | sed "s/:CREATED_DATE/'$TRADE_DATE'/g")

  echo "<h4>${desc}</h4>" >> "$HTML_FILE"
  echo "<table>" >> "$HTML_FILE"

  # Get header
  HEADER=$(vsql -U "$VERTICA_USER" -w "$VERTICA_PASS" -d "$VERTICA_DB" -F '|' -At -c \
    "SELECT * FROM ($final_query) AS subquery LIMIT 0;" 2>/dev/null | head -n 1)

  if [ -z "$HEADER" ]; then
    echo "<tr><td colspan='10'><i>No data or query error</i></td></tr>" >> "$HTML_FILE"
    echo "</table><br/>" >> "$HTML_FILE"
    continue
  fi

  # Header row
  echo "$HEADER" | tr '|' '\n' | while read col; do
    echo -n "<th>${col}</th>" >> "$HTML_FILE"
  done
  echo "</tr>" >> "$HTML_FILE"

  # Data rows
  vsql -U "$VERTICA_USER" -w "$VERTICA_PASS" -d "$VERTICA_DB" -F '|' -At -c "$final_query" | while IFS='|' read -r line; do
    echo "<tr>" >> "$HTML_FILE"
    echo "$line" | awk -F'|' '{ for(i=1; i<=NF; i++) printf("<td>%s</td>", $i); print "" }' >> "$HTML_FILE"
    echo "</tr>" >> "$HTML_FILE"
  done

  echo "</table><br/>" >> "$HTML_FILE"
done

# === Close HTML
cat >> "$HTML_FILE" <<EOF
<p>Regards,<br/>Data Team</p>
</body>
</html>
EOF

# === Send Email
s-nail \
  -r "$EMAIL_FROM" \
  -s "Sanity Check Report: $FEED_NAME - $TRADE_DATE" \
  -S smtp=localhost \
  -S mime-type=text/html \
  $EMAIL_TO < "$HTML_FILE"
