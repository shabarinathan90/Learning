SELECT * FROM (SELECT emp_daily, cli_daily, emp_daily - cli_daily AS daily_diff, emp_ytd, cli_ytd, emp_ytd - cli_ytd AS ytd_diff FROM (SELECT SUM(daily_cv) AS emp_daily, SUM(ytd_cv) AS emp_ytd FROM active.empcv) emp, (SELECT SUM(daily_cv) AS cli_daily, SUM(ytd_cv) AS cli_ytd FROM active.clientcv) cli) diff WHERE emp_daily != cli_daily OR emp_ytd != cli_ytd UNION ALL SELECT NULL, NULL, NULL, NULL, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM (SELECT emp_daily, cli_daily, emp_ytd, cli_ytd FROM (SELECT SUM(daily_cv) AS emp_daily, SUM(ytd_cv) AS emp_ytd FROM active.empcv) emp, (SELECT SUM(daily_cv) AS cli_daily, SUM(ytd_cv) AS cli_ytd FROM active.clientcv) cli) WHERE emp_daily != cli_daily OR emp_ytd != cli_ytd);
