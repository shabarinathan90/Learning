#!/bin/bash

# Output file name
OUTPUT_FILE="merged_tsd_daily.csv"

# Remove the output file if it exists
rm -f "$OUTPUT_FILE"

# Flag to control header inclusion
header_written=false

# Loop through files sorted by date (filename includes YYYYMMDD)
for file in $(ls Src_tsd_daily_*.csv | sort); do
    if [ "$header_written" = false ]; then
        # Write the header and data from the first file
        cat "$file" >> "$OUTPUT_FILE"
        header_written=true
    else
        # Skip header (first line) and append data
        tail -n +2 "$file" >> "$OUTPUT_FILE"
    fi
done

echo "Merged file created: $OUTPUT_FILE"
